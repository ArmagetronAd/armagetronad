{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Build and Test Debug",
      "command": "MAKEFLAGS=--no-print-directory ${workspaceFolder}/batch/test_builds.sh debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/build/test_vs_server_debug/src"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "label": "Build Debug Client",
      "command": "MAKEFLAGS=--no-print-directory BUILD_ONLY=1 ${workspaceFolder}/batch/test_builds.sh client_debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/build/test_vs_client_debug/src"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "shell",
      "label": "Build Debug Server",
      "command": "BUILD_ONLY=1 ${workspaceFolder}/batch/test_builds.sh server_debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/build/test_vs_server_debug/src"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "shell",
      "label": "Full Build and Test",
      "command": "${workspaceFolder}/batch/test_builds.sh full",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/build/test_vs_server_debug/src"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "shell",
      "label": "Clean",
      "command": "${workspaceFolder}/batch/test_builds.sh clean",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "type": "shell",
      "label": "Build Debug",
      "command": "BUILD_ONLY=1 ${workspaceFolder}/batch/test_builds.sh debug",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/build/test_vs_server_debug/src"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}